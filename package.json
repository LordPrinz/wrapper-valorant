{
  "name": "wrapper-valorant-api",
  "version": "3.0.0",
  "description": "Zero-runtime-dependency TypeScript client for the official Riot VALORANT APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "License"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts --clean --target node22",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "publint && attw --pack .",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check && npm run pack:smoke",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordPrinz/wrapper-valorant.git"
  },
  "homepage": "https://github.com/LordPrinz/wrapper-valorant#readme",
  "bugs": {
    "url": "https://github.com/LordPrinz/wrapper-valorant/issues"
  },
  "keywords": [
    "valorant",
    "riot-games",
    "riot-api",
    "typescript",
    "sdk",
    "zero-dependency"
  ],
  "author": "LordPrinz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.4",
    "publint": "^0.3.21",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
